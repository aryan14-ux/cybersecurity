# Database
DATABASE_URL="postgresql://xsslab:xsslab_dev_password@localhost:5432/xsslab?schema=public"

# NextAuth
AUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Lab Environment Origin (for subdomain isolation in production)
LABS_ORIGIN="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"

# Scanner
SCANNER_RATE_LIMIT_PER_HOUR="10"
SCANNER_ALLOWED_ORIGINS="http://localhost:3000"
